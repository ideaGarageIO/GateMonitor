# Gate / Farm Monitor server configuration (all optional; defaults shown)

# Web server
HOST=0.0.0.0
PORT=8000
DEBUG=false                 # true = auto-reload on code changes
LOG_LEVEL=INFO

# MQTT broker
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# MQTT_CLIENT_ID=           # default: gate_monitor_<hostname>_<pid>

# Simulated coops + solar until real hardware exists
SIMULATE_DEVICES=true
LATITUDE=40.0               # used for the simulated sunrise/sunset schedule
LONGITUDE=-105.0

# Home Assistant MQTT discovery
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant
# PUBLIC_URL=http://192.168.1.50:8000   # "Visit" link on HA device pages

# History (SQLite)
# DB_PATH=./data/gate_monitor.db
RECORD_INTERVAL_S=15        # min seconds between stored samples per device
HISTORY_DAYS=30             # telemetry retention; events are kept 4x longer
